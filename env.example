# LiteLLM model identifier used by every Agent4RE agent.
AGENT4RE_MODEL=azure/gpt-4o

# Azure OpenAI authentication. Use AZURE_API_KEY, or use
# AZURE_OPENAI_AD_TOKEN for Microsoft Entra ID authentication.
AZURE_API_KEY=
AZURE_OPENAI_AD_TOKEN=
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2025-01-01-preview

# For local Ollama, replace AGENT4RE_MODEL with a model such as:
# AGENT4RE_MODEL=ollama_chat/qwen3:8b
